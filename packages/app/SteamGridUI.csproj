<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.3</Version>
    <ApplicationIcon>..\..\assets\app\main.ico</ApplicationIcon>
    <AssemblyName>SteamGridUI</AssemblyName>
    <RootNamespace>SteamGridUI</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <CoreDir>$(MSBuildProjectDirectory)\..\core</CoreDir>
  </PropertyGroup>

  <!-- `dotnet publish` gives one exe with the Rust core inside -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!-- the rust backend is built as part of the C# build and copied next to the exe -->
  <Target Name="BuildRustCore" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build --release" WorkingDirectory="$(CoreDir)" />
  </Target>

  <ItemGroup>
    <None Include="$(CoreDir)\target\release\sgdb_core.dll" Link="sgdb_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
