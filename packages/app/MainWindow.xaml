<Window x:Class="SteamGridUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamGridUI"
        Title="Steam Grid UI" Width="1320" Height="840" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- library -->
      <DockPanel Grid.Column="0" Margin="8">
        <ComboBox x:Name="UserBox" DockPanel.Dock="Top" DisplayMemberPath="Name"
                  ToolTip="Steam account" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,6,0,0" Padding="4"
                 ToolTip="Filter by name or appid" />
        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
          <ComboBox x:Name="SortBox" DockPanel.Dock="Right" SelectedIndex="0" ToolTip="Order of the list">
            <ComboBoxItem Content="By name" />
            <ComboBoxItem Content="By ID" />
          </ComboBox>
          <CheckBox x:Name="InstalledOnly" VerticalAlignment="Center" IsChecked="True"
                    Content="Installed games only" Click="OnInstalledOnlyClick" />
        </DockPanel>
        <CheckBox x:Name="IdsFirst" DockPanel.Dock="Top" Margin="0,6,0,6" Content="Show IDs instead of names" />
        <Button DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" Content="API key…" Click="OnApiKey" />
        <ListBox x:Name="GamesList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2">
                <TextBlock x:Name="First" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                <DockPanel>
                  <TextBlock x:Name="Second" Text="{Binding AppId}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=IdsFirst}" Value="True">
                  <Setter TargetName="First" Property="Text" Value="{Binding AppId}" />
                  <Setter TargetName="Second" Property="Text" Value="{Binding Display}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <!-- artwork -->
      <DockPanel Grid.Column="2" Margin="4,8,8,8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <ComboBox x:Name="KindBox" Width="150" SelectedIndex="0">
            <ComboBoxItem Tag="{x:Static local:ArtKind.Grid}" Content="Portrait grid" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Wide}" Content="Wide grid" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Hero}" Content="Hero" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Logo}" Content="Logo" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Icon}" Content="Icon" />
          </ComboBox>
          <CheckBox x:Name="AnimatedBox" Margin="14,0,0,0" VerticalAlignment="Center" Content="Animated" Click="OnOptionClick" />
          <CheckBox x:Name="HumorBox" Margin="14,0,0,0" VerticalAlignment="Center" Content="Humor" IsChecked="True" Click="OnOptionClick" />
          <CheckBox x:Name="NsfwBox" Margin="14,0,0,0" VerticalAlignment="Center" Content="NSFW" Click="OnOptionClick" />
        </WrapPanel>

        <DockPanel x:Name="Actions" DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
          <Button x:Name="ApplyBtn" Padding="12,4" Content="Apply to Steam" IsEnabled="False" Click="OnApply" />
          <Button x:Name="SaveBtn" Margin="6,0,0,0" Padding="12,4" Content="Save as…" IsEnabled="False" Click="OnSaveAs" />
          <Button x:Name="RevertBtn" Margin="6,0,0,0" Padding="12,4" Content="Remove custom art" IsEnabled="False" Click="OnRevert"
                  ToolTip="Go back to Steam's default for this slot. The current file is moved to the backup folder." />
          <Button x:Name="MoreBtn" DockPanel.Dock="Right" Padding="12,4" Content="Load more" IsEnabled="False" Click="OnMore" />
        </DockPanel>

        <ListBox x:Name="AssetsList" MouseDoubleClick="OnAssetDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="{Binding TileW}" Margin="4">
                <Border Height="{Binding TileH}" Background="#22262D">
                  <Grid>
                    <TextBlock Text="{Binding Placeholder}" Foreground="#8A93A3" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Info}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
