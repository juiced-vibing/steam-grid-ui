<Window x:Class="SteamGridUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamGridUI"
        Title="Steam Grid UI" Width="1320" Height="840" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
  <Window.Resources>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="{StaticResource Gap}">
        <ComboBox x:Name="UserBox" DockPanel.Dock="Top" DisplayMemberPath="Name"
                  ToolTip="Steam account" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="{StaticResource GapTop}"
                 ToolTip="Filter by name or appid" />
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource GapTop}">
          <ComboBox x:Name="SortBox" DockPanel.Dock="Right" SelectedIndex="0" ToolTip="Order of the list">
            <ComboBoxItem Content="By name" />
            <ComboBoxItem Content="By ID" />
          </ComboBox>
          <CheckBox x:Name="InstalledOnly" VerticalAlignment="Center" IsChecked="True"
                    Content="Installed games only" Click="OnInstalledOnlyClick" />
        </DockPanel>
        <CheckBox x:Name="IdsFirst" DockPanel.Dock="Top" Margin="{StaticResource GapTop}" Content="Show IDs instead of names" />
        <Button DockPanel.Dock="Bottom" Margin="{StaticResource GapTop}" Content="API key…" Click="OnApiKey" />
        <ListBox x:Name="GamesList" Margin="{StaticResource GapTop}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock x:Name="First" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                <DockPanel>
                  <TextBlock x:Name="Second" Text="{Binding AppId}" Style="{StaticResource Caption}" />
                  <TextBlock Text="{Binding Tags}" Style="{StaticResource Caption}" />
                </DockPanel>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=IdsFirst}" Value="True">
                  <Setter TargetName="First" Property="Text" Value="{Binding AppId}" />
                  <Setter TargetName="Second" Property="Text" Value="{Binding Display}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <DockPanel Grid.Column="2" Margin="{StaticResource Gap}">
        <WrapPanel DockPanel.Dock="Top">
          <WrapPanel.Resources>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
              <Setter Property="Margin" Value="{StaticResource GapLeft}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </WrapPanel.Resources>

          <ComboBox x:Name="KindBox" Width="150" SelectedIndex="0">
            <ComboBoxItem Tag="{x:Static local:ArtKind.Grid}" Content="Portrait grid" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Wide}" Content="Wide grid" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Hero}" Content="Hero" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Logo}" Content="Logo" />
            <ComboBoxItem Tag="{x:Static local:ArtKind.Icon}" Content="Icon" />
          </ComboBox>
          <CheckBox x:Name="AnimatedBox" Content="Animated" Click="OnOptionClick" />
          <CheckBox x:Name="HumorBox" Content="Humor" IsChecked="True" Click="OnOptionClick" />
          <CheckBox x:Name="NsfwBox" Content="NSFW" Click="OnOptionClick" />
          <ComboBox x:Name="MatchBox" Margin="{StaticResource GapLeft}" MinWidth="200" DisplayMemberPath="Label" Visibility="Collapsed"
                    ToolTip="The SteamGridDB game this non-Steam game takes its artwork from" />
        </WrapPanel>

        <DockPanel x:Name="Actions" DockPanel.Dock="Bottom" Margin="{StaticResource GapTop}" LastChildFill="False">
          <Button x:Name="ApplyBtn" Content="Apply to Steam" IsEnabled="False" Click="OnApply" />
          <Button x:Name="SaveBtn" Margin="{StaticResource GapLeft}" Content="Save as…" IsEnabled="False" Click="OnSaveAs" />
          <Button x:Name="RevertBtn" Margin="{StaticResource GapLeft}" Content="Remove custom art" IsEnabled="False" Click="OnRevert"
                  ToolTip="Go back to Steam's default for this slot. The current file is moved to the backup folder." />
          <Button x:Name="MoreBtn" DockPanel.Dock="Right" Content="Load more" IsEnabled="False" Click="OnMore" />
        </DockPanel>

        <ListBox x:Name="AssetsList" Margin="{StaticResource GapTop}" MouseDoubleClick="OnAssetDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="{Binding TileW}">
                <Border Height="{Binding TileH}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                  <Grid>
                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Info}" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource HalfGapTop}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
